# Copie para .env no servidor (chmod 600) e preencha. NUNCA versione o .env.
# Evite o caractere $ nos valores: o Docker Compose o interpreta como variável.

# Banco de dados
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=<senha forte: python3 -c "import secrets; print(secrets.token_urlsafe(24))">
POSTGRES_DB=helpdesk

# Segurança (JWT)
SECRET_KEY=<python3 -c "import secrets; print(secrets.token_hex(32))">

# Object storage S3 (RustFS). Os nomes MINIO_* são herdados do SDK `minio`,
# usado como cliente S3; MINIO_ROOT_USER/PASSWORD são a access key e a secret
# key do storage.
MINIO_ROOT_USER=helpdesk
MINIO_ROOT_PASSWORD=<senha forte, mínimo 8 caracteres>
MINIO_BUCKET_NAME=helpdesk-attachments
MINIO_PUBLIC_ENDPOINT=files.seudominio.com
MINIO_PUBLIC_SECURE=true

# Domínios e certificado (Let's Encrypt via Caddy)
API_DOMAIN=api.seudominio.com
FILES_DOMAIN=files.seudominio.com
ACME_EMAIL=voce@seudominio.com

# POSTGRES_HOST, MINIO_INTERNAL_ENDPOINT e REDIS_URL são definidos pelo
# docker-compose.prod.yml (nomes dos serviços na rede interna).